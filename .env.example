# Use "development" for npm run dev. npm start always forces production mode.
NODE_ENV=production
PORT=3000

# Required. Gemini API credential used by the server; never expose it to the browser.
GEMINI_API_KEY=

# Public application origin used for safe authentication redirects.
APP_URL=https://exepts.com

# Google OAuth web application credentials. The redirect URI must exactly match
# the authorized callback configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://exepts.com/api/auth/google/callback

# Brevo transactional email configuration for passwordless verification codes.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=one@exepts.com
BREVO_SENDER_NAME=Exepts

# Required. External Supabase/PostgreSQL connection URL.
# The database must permit the pgvector extension. Migrations run automatically at startup.
SUPABASE_DB_URL=

# Keep false for all normal and production deployments.
# Demo records are created only through an explicit true opt-in.
SEED_DEMO_DATA=false

# Leave all three values empty unless performing the explicitly supported
# one-time migration of an existing passwordless prototype owner account.
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_FIRM_ID=
LEGACY_OWNER_INITIAL_PASSWORD=
