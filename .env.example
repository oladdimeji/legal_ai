# Use "development" for npm run dev. npm start always forces production mode.
NODE_ENV=production
PORT=3004

# Private preview is enabled by default. Set exactly false to restore public access.
SITE_LOCKED=true
SITE_REOPENS_AT=
SITE_ALLOWED_EMAILS=

# Example private-preview configuration only:
# SITE_REOPENS_AT=2026-08-15T09:00:00Z
# SITE_ALLOWED_EMAILS=oladimeji@workpodd.com,themamatra01@gmail.com, rasheedmuhammed002@gmail.com

# Required. Gemini API credential used by the server; never expose it to the browser.
GEMINI_API_KEY=

# Public application origin used for safe authentication redirects.
APP_URL=https://exepts.com

# Google OAuth web application credentials. The redirect URI must exactly match
# the authorized callback configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://exepts.com/api/auth/google/callback
# Dedicated technical-administration callback using the same Google OAuth client.
GOOGLE_ADMIN_OAUTH_REDIRECT_URI=https://exepts.com/api/admin/auth/google/callback

# Brevo transactional email configuration for passwordless verification codes.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=one@exepts.com
BREVO_SENDER_NAME=Exepts
# Comma-separated Exepts technical administrators. This is the sole admin allowlist.
ACCESS_REVIEW_ADMIN_EMAILS=
# At least 32 characters. Signs the short-lived technical-admin cookie only.
ADMIN_SESSION_SECRET=

# Required. External Supabase/PostgreSQL connection URL.
# The database must permit the pgvector extension. Migrations run automatically at startup.
SUPABASE_DB_URL=

# Keep false for all normal and production deployments.
# Demo records are created only through an explicit true opt-in.
SEED_DEMO_DATA=false

# Leave all three values empty unless performing the explicitly supported
# one-time migration of an existing passwordless prototype owner account.
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_FIRM_ID=
LEGACY_OWNER_INITIAL_PASSWORD=

# Public browser picker identifiers only. Never place a client secret in a VITE_ variable.
# Google Drive is shown only when all three Google values are configured.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=
# Dropbox Chooser is shown only when its browser app key is configured.
VITE_DROPBOX_APP_KEY=
