# Use "development" for npm run dev. npm start always forces production mode.
NODE_ENV=production
PORT=3000

# Required. Gemini API credential used by the server; never expose it to the browser.
GEMINI_API_KEY=

# Required. External Supabase/PostgreSQL connection URL.
# The database must permit the pgvector extension. Migrations run automatically at startup.
SUPABASE_DB_URL=

# Keep false for all normal and production deployments.
# Demo records are created only through an explicit true opt-in.
SEED_DEMO_DATA=false

# Leave all three values empty unless performing the explicitly supported
# one-time migration of an existing passwordless prototype owner account.
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_FIRM_ID=
LEGACY_OWNER_INITIAL_PASSWORD=

# =========================================================
# SUPABASE STORAGE
# =========================================================
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=exepts-documents
OBJECT_STORAGE_PROVIDER=supabase
JOBS_PROVIDER=pg-boss
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# =========================================================
# GOOGLE OAUTH — USE DIFFERENT CLIENTS FOR LOCAL/STAGING/PRODUCTION
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Required only when a provider refresh-token feature is enabled.
# Generate a canonical base64-encoded 32-byte key and keep it server-side.
APP_ENCRYPTION_KEY_BASE64=

# =========================================================
# LIVE LEGAL SOURCES
# =========================================================
GOVINFO_API_KEY=
GOVINFO_BASE_URL=https://api.govinfo.gov
# Test-process opt-in only; never enable in standard CI.
GOVINFO_LIVE_SMOKE=false

# =========================================================
# FEATURE FLAGS
# Start every new feature false. Turn it on only after its staging gate passes.
# =========================================================
# The public route shell and landing page are installed by the routing phase.
FEATURE_PUBLIC_LANDING=false
FEATURE_ASYNC_INGESTION=false
FEATURE_GOVINFO=false
FEATURE_COURTLISTENER=false
FEATURE_GOOGLE_DRIVE=false
FEATURE_GMAIL_SEND=false
FEATURE_OCR=false
# Exact gate for reserved client-account routes. Legacy /client/:token is independent.
FEATURE_CLIENT_ACCOUNTS=false
FEATURE_FIRM_TEAMS=false
# Exact gate for private direct/resumable originals. Keep false until storage staging passes.
FEATURE_PRIVATE_STORAGE=false

# Provider selections are configuration boundaries only in this phase.
TRANSACTIONAL_EMAIL_PROVIDER=
OBSERVABILITY_PROVIDER=
