# Exepts is a single web application. It has no product feature flags.
# Required in production: APP_BASE_URL, GEMINI_API_KEY, and SUPABASE_DB_URL.
NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:3000
GEMINI_API_KEY=
SUPABASE_DB_URL=

# Operational safety control. Startup never seeds unless this is explicitly true.
SEED_DEMO_DATA=false

# Supply all three only for the explicit one-time legacy-owner migration.
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_FIRM_ID=
LEGACY_OWNER_INITIAL_PASSWORD=

# Optional GovInfo integration. It activates automatically when the API key is present.
GOVINFO_API_KEY=
GOVINFO_BASE_URL=https://api.govinfo.gov

# Optional Google account linking, linked sign-in, and Drive export.
# All four values are required together; APP_ENCRYPTION_KEY_BASE64 must decode to 32 bytes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APP_ENCRYPTION_KEY_BASE64=

# Optional Brevo transactional email. All values are required together.
# When absent, authorized invitation creators receive a one-time copyable invitation URL.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Exepts
BREVO_API_BASE_URL=https://api.brevo.com/v3
