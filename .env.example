# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_DB_URL: Connection URL for Supabase Postgres Database (free tier, with pgvector enabled).
# Stored in Settings -> Secrets as SUPABASE_DB_URL.
SUPABASE_DB_URL=""

# Demo records are never created unless this exact opt-in is enabled.
SEED_DEMO_DATA="false"

# Required together only when migrating an existing passwordless prototype account.
LEGACY_OWNER_USER_ID=""
LEGACY_OWNER_FIRM_ID=""
LEGACY_OWNER_INITIAL_PASSWORD=""
